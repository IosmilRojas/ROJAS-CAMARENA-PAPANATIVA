{
  "name": "papa-clasificador",
  "main": "electron-main.js",
  "version": "1.0.0",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "electron:dev": "electron .",
  "generate-icon": "node scripts/generate-icon.js",
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "jest"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.9",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "moment": "^2.29.4",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.17.2",
    "sharp": "^0.32.6",
    "svg2png": "^4.1.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "electron": "^26.3.0",
    "electron-builder": "^24.6.0",
    "png-to-ico": "^2.0.0"
  },
  "build": {
    "appId": "com.papaia.clasificador",
    "productName": "PapaIA",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!node_modules/*/{test,__tests__,docs}/**",
      "!dist/**"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    }
  }
}
