<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Auditoría - Interfaz</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .card-header .controls { gap: .5rem; }
    .table-fixed { table-layout: fixed; word-wrap: break-word; }
    pre.small { white-space: pre-wrap; max-height: 6rem; overflow: auto; }
  </style>
    <link rel="icon" type="image/jpeg" href="/assets/images/logo2.jpg">
    <link rel="shortcut icon" href="/assets/images/logo2.jpg">
</head>
<body class="bg-light">
  <%- include('partials/navbar') %>

  <div class="container mt-4">
    <div class="card">
      <div class="card-header d-flex align-items-center justify-content-between">
        <div>
          <h5 class="mb-0"><i class="fas fa-file-alt me-2"></i>Interfaz de Auditoría</h5>
          <small class="text-muted">Filtra los registros y exporta a PDF/Excel</small>
        </div>
        <div class="controls d-flex align-items-center">
          <% if (typeof usuario !== 'undefined' && usuario.rol === 'administrador') { %>
            <button id="exportPdfBtn" class="btn btn-outline-primary btn-sm"><i class="fas fa-file-pdf me-1"></i> Exportar PDF</button>
            <button id="exportExcelBtn" class="btn btn-outline-success btn-sm"><i class="fas fa-file-excel me-1"></i> Exportar Excel</button>
          <% } %>
        </div>
      </div>

      <div class="card-body">
        <form id="filterForm" class="row g-3 align-items-end">
          <div class="col-md-3">
            <label class="form-label">Fecha inicio</label>
            <input type="date" name="fechaInicio" class="form-control">
          </div>
          <div class="col-md-3">
            <label class="form-label">Fecha fin</label>
            <input type="date" name="fechaFin" class="form-control">
          </div>
          <div class="col-md-3">
            <label class="form-label">Tipo de acción</label>
            <select name="tipoAccion" class="form-select">
              <option value="">Todos</option>
              <option value="generar_reporte">generar_reporte</option>
              <option value="exportar_estadisticas">exportar_estadisticas</option>
              <option value="exportar_datos">exportar_datos</option>
              <option value="entrenar_modelo">entrenar_modelo</option>
              <option value="cambiar_rol">cambiar_rol</option>
              <option value="login">login</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">Usuario (id)</label>
            <input type="text" name="idUsuario" class="form-control" placeholder="ObjectId...">
          </div>

          <div class="col-12 d-flex justify-content-end">
            <button type="button" id="btnBuscar" class="btn btn-primary me-2">Buscar</button>
            <button type="button" id="btnLimpiar" class="btn btn-secondary">Limpiar</button>
          </div>
        </form>

        <hr />

        <div id="resultados" class="table-responsive">
          <table class="table table-sm table-fixed">
            <thead>
              <tr class="text-muted small">
                <th style="width:18%">Fecha</th>
                <th style="width:20%">Usuario</th>
                <th style="width:12%">Acción</th>
                <th style="width:40%">Descripción / Datos</th>
                <th style="width:10%">IP</th>
              </tr>
            </thead>
            <tbody id="tbodyResultados">
              <tr><td colspan="5" class="text-muted">Use el formulario y haga click en Buscar para cargar registros.</td></tr>
            </tbody>
          </table>
        </div>

      </div>
    </div>
  </div>

  <script>
    async function fetchRegistros(params = {}) {
      const qs = new URLSearchParams(params).toString();
      const url = '/reportes/api/exportar-auditoria' + (qs ? ('?' + qs) : '');
      // Nota: la ruta ya devuelve PDF. Para obtener JSON aquí podríamos crear una API, pero por simplicidad
      // haremos una llamada a una nueva ruta de obtención (no creada aún). Si deseas, la creo.
      // Por ahora, intentamos obtener JSON vía /api/trabajo temporal no implementado.
      return null;
    }

    document.getElementById('btnBuscar').addEventListener('click', async () => {
      const form = document.getElementById('filterForm');
      const data = Object.fromEntries(new FormData(form).entries());

      // Construir query y abrir la exportación PDF en nueva pestaña
      const params = {};
      if (data.fechaInicio) params.fechaInicio = data.fechaInicio;
      if (data.fechaFin) params.fechaFin = data.fechaFin;
      if (data.tipoAccion) params.tipoAccion = data.tipoAccion;
      if (data.idUsuario) params.idUsuario = data.idUsuario;

      // Abrir PDF de auditoría con los filtros
      const qs = new URLSearchParams(params).toString();
      const exportUrl = '/reportes/api/exportar-auditoria' + (qs ? ('?' + qs) : '');
      window.open(exportUrl, '_blank');
    });

    document.getElementById('btnLimpiar').addEventListener('click', () => {
      document.getElementById('filterForm').reset();
    });

    document.getElementById('exportPdfBtn')?.addEventListener('click', () => {
      document.getElementById('btnBuscar').click();
    });

    document.getElementById('exportExcelBtn')?.addEventListener('click', () => {
      const form = document.getElementById('filterForm');
      const data = Object.fromEntries(new FormData(form).entries());
      const params = {};
      if (data.fechaInicio) params.fechaInicio = data.fechaInicio;
      if (data.fechaFin) params.fechaFin = data.fechaFin;
      if (data.tipoAccion) params.tipoAccion = data.tipoAccion;
      if (data.idUsuario) params.idUsuario = data.idUsuario;
      const qs = new URLSearchParams(params).toString();
      // There's no Excel route for auditoría yet; if you want I can add one.
      // For now we reuse the PDF endpoint.
      window.open('/reportes/api/exportar-auditoria' + (qs ? ('?' + qs) : ''), '_blank');
    });
  </script>

</body>
</html>
